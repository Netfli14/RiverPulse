ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Browser-restricted Google Maps key (optional: embedded Google map is used without it).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Generate a different 32+ character token per robot. Never put it in NEXT_PUBLIC_*.
ROBOT_INGEST_TOKEN=
# Optional for Vercel cloud telemetry storage. Apply docs/supabase-telemetry.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
